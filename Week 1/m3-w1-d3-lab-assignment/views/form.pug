extends layout

block content
  -data = data || {}

  if errors
    ul(style="color: red;")
      for error in errors
        li= error.msg

  form(action="." method="POST")
    label(for="name") Name: 
    br
    input(
      type="text"
      id="name"
      name="name"
      value=data.name
      placeholder="Your full name"
    )
    br
    br

    label(for="email") Email:
    br
    input(
      type="email"
      id="email"
      name="email"
      value=data.email
      placeholder="Your email address"
    )
    br
    br
    input(type="submit" value="Submit")