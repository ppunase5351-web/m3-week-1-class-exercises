extends layout

block content
  aside#leftside
  aside#rightside
  #container
    header
      headcomp
    main
      aside#photos
        img(src="/images/chili.jpg", alt="White Chicken Chili", width="180")
      h2
        blogtitle
      section#blogposts
        ul
          li#posts(v-for="post in posts")
            span.profile
              img(v-bind:src="post.profilepic", v-on:click="authorinfo(posts, post)")
            span.author {{ post.name }}
            | &nbsp;&mdash;&nbsp;
            span.date {{ post.date }}
            | &nbsp;
            span.reply {{ post.reply }}
            p {{ post.message }}
          #info_box(v-for="post in posts", v-if="post.thisBox")
            p.closeBtn.closeBtnP(v-on:click="$emit('close', post.thisBox = false)") &#10006;
            #info_title {{ post.name }}
            #info_foodie
              span Foodie Level:
              | &nbsp;{{ post.foodielevel }}
            #info_bio
              span Bio:
                br
              | {{ post.bio }}
            button.closeBtn.closeBtnB(v-on:click="$emit('close', post.thisBox = false)") Close
            p#close_info
    footer &copy; Copyright FOOD BLOG
  script(src="/javascripts/vue.js")
